#Bronze Notebook
Authentication#
spark.conf.set(
    "fs.azure.account.key.mdaseem001.dfs.core.windows.net",
    "<YOUR_STORAGE_ACCOUNT_KEY>"
)

#Paths#
landing_path = "abfss://landing@mdaseem001.dfs.core.windows.net/customers/master_customer_dirty.csv"

bronze_path = "abfss://bronze@mdaseem001.dfs.core.windows.net/cust


#Imports#
from pyspark.sql.functions import *



#Read Landing CSV#
bronze_df = (
    spark.read
    .option("header", "true")
    .option("inferSchema", "true")
    .csv(landing_path)
)


#Add Metadata#

#Because Unity Catalog doesn't support input_file_name(), we used _metadata.file_path.#

bronze_df = (
    bronze_df
    .withColumn("ingestion_timestamp", current_timestamp())
    .withColumn("source_file", col("_metadata.file_path"))
)



#Write Bronze Delta#
(
    bronze_df.write
        .format("delta")
        .mode("overwrite")
        .save(bronze_path)
)



#Verify Bronze#
bronze = spark.read.format("delta").load(bronze_path)

display(bronze)

print(bronze.count())

bronze.printSchema()












